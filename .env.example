# Copy to .env and replace the placeholder secrets before deploying.
# Never commit a real .env file.

# PostgreSQL (used by docker compose for the db service and the app)
POSTGRES_USER=fde
POSTGRES_PASSWORD=replace-with-a-long-random-value
POSTGRES_DB=fde

# JWT signing secret for the app
JWT_SECRET=replace-with-a-long-random-value

# Optional seed admin, created at first startup when both are set
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Host binding for the app port (set to a Tailscale IP to expose the
# service on the tailnet only)
APP_BIND=0.0.0.0
APP_PORT=8100
